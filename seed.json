{
  "nodes": [
    {"id":"sc","label":"供应链","category":"概念","desc":"从原材料到送达用户的全链路管理，含商流、物流、资金流、信息流。","tags":["核心"]},
    {"id":"lg","label":"物流","category":"概念","desc":"货物与信息的实体流动与存储管理，供应链的子集。","tags":["核心"]},
    {"id":"il","label":"国际物流","category":"概念","desc":"物流跨越国境的形态，叠加海关、跨国合规与国际运输。","tags":["跨境"]},
    {"id":"cl","label":"跨境物流","category":"概念","desc":"同国际物流，偏电商小包/海外仓等业务场景。","tags":["跨境"]},
    {"id":"3flow","label":"三流合一","category":"概念","desc":"实物流+资金流+信息流协同，跨境要三流都跨国。","tags":["框架"]},

    {"id":"fcl","label":"FCL 整柜","category":"术语","desc":"整集装箱装满一个柜子发运，海运最常见单位。","tags":["海运"]},
    {"id":"lcl","label":"LCL 拼箱","category":"术语","desc":"货量不足一柜时与其他货主拼同一柜，需多一道拼拆。","tags":["海运"]},
    {"id":"teu","label":"TEU","category":"术语","desc":"20英尺标准集装箱当量，运力计量单位。","tags":["计量"]},
    {"id":"eta","label":"ETA","category":"术语","desc":"预计到港/到货时间。","tags":["时效"]},
    {"id":"etd","label":"ETD","category":"术语","desc":"预计离港时间。","tags":["时效"]},
    {"id":"d2d","label":"门到门","category":"术语","desc":"从发货人工厂到收货人地址全程包办的物流服务。","tags":["服务模式"]},
    {"id":"mto","label":"多式联运","category":"术语","desc":"两种以上运输方式组合，一张提单管全程。","tags":["运输"]},
    {"id":"dwt","label":"物权凭证","category":"术语","desc":"谁持有正本提单谁拥有提货权，国际贸易核心风险控制点。","tags":["风险","单证"]},

    {"id":"exw","label":"EXW","category":"Incoterms","desc":"工厂交货，卖方责任最小。","tags":["Incoterms"]},
    {"id":"fca","label":"FCA","category":"Incoterms","desc":"货交承运人，多式联运下常用。","tags":["Incoterms"]},
    {"id":"fas","label":"FAS","category":"Incoterms","desc":"船边交货，传统海运散杂术语。","tags":["Incoterms"]},
    {"id":"fob","label":"FOB","category":"Incoterms","desc":"装船越过船舷风险转移，海运经典术语。","tags":["Incoterms"]},
    {"id":"cfr","label":"CFR","category":"Incoterms","desc":"成本加运费，卖方付运费但风险装船即转移。","tags":["Incoterms"]},
    {"id":"cif","label":"CIF","category":"Incoterms","desc":"成本保险费加运费，卖方包运费+保险。","tags":["Incoterms"]},
    {"id":"cpt","label":"CPT","category":"Incoterms","desc":"运费付至，多式联运版CFR。","tags":["Incoterms"]},
    {"id":"cip","label":"CIP","category":"Incoterms","desc":"运费保险费付至，多式联运版CIF。","tags":["Incoterms"]},
    {"id":"dap","label":"DAP","category":"Incoterms","desc":"目的地交货未卸货。","tags":["Incoterms"]},
    {"id":"dpu","label":"DPU","category":"Incoterms","desc":"目的地卸货后交货。","tags":["Incoterms"]},
    {"id":"ddp","label":"DDP","category":"Incoterms","desc":"完税后交货，卖方连关税都包，责任最大。","tags":["Incoterms"]},

    {"id":"tsea","label":"海运","category":"运输","desc":"成本最低、时效最慢，大宗/重货首选。","tags":["慢","便宜"]},
    {"id":"tair","label":"空运","category":"运输","desc":"时效最快、成本最高，高值急货样品首选。","tags":["快","贵"]},
    {"id":"train","label":"国际铁路","category":"运输","desc":"中欧班列为主，亚欧间中等货值的中庸选择。","tags":["中欧班列"]},
    {"id":"truck","label":"国际公路","category":"运输","desc":"邻国门到门为主，受载重限制。","tags":["周边"]},

    {"id":"p_factory","label":"工厂","category":"参与者","desc":"生产或提供货物，是供应链的源头。","tags":["源头"]},
    {"id":"p_exporter","label":"出口商","category":"参与者","desc":"组织货源、订舱、办理出口报关。","tags":["贸易"]},
    {"id":"p_ff","label":"货代","category":"参与者","desc":"货运代理，代订舱、报关、拼箱、单证，是中小卖家全能管家。","tags":["服务"]},
    {"id":"p_carrier","label":"承运人","category":"参与者","desc":"船司/航司/铁路，实际运输工具所有者。","tags":["运输"]},
    {"id":"p_broker","label":"报关行","category":"参与者","desc":"代理进出口报关与缴税。","tags":["关务"]},
    {"id":"p_customs","label":"海关","category":"参与者","desc":"监管进出境、征税、查验放行。","tags":["关务"]},
    {"id":"p_3pl","label":"海外仓","category":"参与者","desc":"目的国本土第三方仓储。","tags":["仓储"]},
    {"id":"p_lastmile","label":"末端配送","category":"参与者","desc":"本土最后一公里快递。","tags":["配送"]},
    {"id":"p_buyer","label":"买家","category":"参与者","desc":"收货付款方。","tags":["终端"]},
    {"id":"p_bank","label":"银行","category":"参与者","desc":"信用证开证/议付、跨境结算。","tags":["支付"]},

    {"id":"proc_export","label":"出口报关","category":"流程","desc":"备单→申报→审单→查验→放行装船。","tags":["出口"]},
    {"id":"proc_import","label":"进口清关","category":"流程","desc":"缴税+查验+放行提货。","tags":["进口"]},
    {"id":"proc_loading","label":"装船","category":"流程","desc":"货物从码头吊装上船，风险转移点(FOB等)。","tags":["海运"]},
    {"id":"proc_unload","label":"卸货","category":"流程","desc":"目的港卸船入库。","tags":["海运"]},
    {"id":"proc_pack","label":"装箱","category":"流程","desc":"货物装入集装箱。","tags":["海运"]},
    {"id":"proc_lcl","label":"拼箱","category":"流程","desc":"LCL货在仓库拼入同一柜。","tags":["LCL"]},
    {"id":"proc_deliver","label":"末端配送","category":"流程","desc":"海外仓/港口到买家手中。","tags":["末端"]},
    {"id":"proc_return","label":"退运","category":"流程","desc":"退货逆向回到原产地。","tags":["逆向"]},

    {"id":"d_invoice","label":"商业发票","category":"单证","desc":"交易金额凭证，报关缴税依据。","tags":["核心"]},
    {"id":"d_pl","label":"装箱单","category":"单证","desc":"货物明细/件重尺。","tags":["核心"]},
    {"id":"d_bl","label":"提单 B/L","category":"单证","desc":"海运货物收据+物权凭证+运输合同。","tags":["物权"]},
    {"id":"d_awb","label":"空运单 AWB","category":"单证","desc":"空运货物收据，非严格物权凭证。","tags":["空运"]},
    {"id":"d_co","label":"原产地证 CO","category":"单证","desc":"证明货物原产国的通用证书。","tags":["产地"]},
    {"id":"d_rcep","label":"RCEP原产地证","category":"单证","desc":"亚太区域内享受RCEP协定减税。","tags":["产地","RCEP"]},
    {"id":"d_ins","label":"保险单","category":"单证","desc":"货损理赔依据，通常按发票110%投保。","tags":["保险"]},
    {"id":"d_lc","label":"信用证 L/C","category":"单证","desc":"银行信用担保的付款承诺。","tags":["支付"]},
    {"id":"d_decl","label":"报关单","category":"单证","desc":"海关申报与放行的官方单据。","tags":["关务"]},
    {"id":"d_pi","label":"形式发票","category":"单证","desc":"Proforma Invoice，用于开证或预付。","tags":["开证"]},

    {"id":"c_hs","label":"HS编码","category":"关务","desc":"全球通用6位编码，决定税率与监管条件。","tags":["核心"]},
    {"id":"c_tariff","label":"关税","category":"关务","desc":"按HS编码税率×完税价格征收。","tags":["税"]},
    {"id":"c_vat","label":"增值税 VAT","category":"关务","desc":"进口增值税，欧盟等普遍，部分可抵扣。","tags":["税"]},
    {"id":"c_ad","label":"反倾销税","category":"关务","desc":"针对特定国家特定商品的加征税。","tags":["税"]},
    {"id":"c_inspect","label":"检验检疫","category":"关务","desc":"对货物安全/卫生/禁限的官方检查。","tags":["监管"]},
    {"id":"c_refund","label":"出口退税","category":"关务","desc":"退还已征国内税，提升出口竞争力。","tags":["税"]},
    {"id":"c_bonded","label":"保税区","category":"关务","desc":"海关监管区，区内暂不缴税。","tags":["保税"]},
    {"id":"c_fta","label":"自贸协定","category":"关务","desc":"国家间互降关税，配套原产地证使用。","tags":["RCEP","FTA"]},

    {"id":"w_dom","label":"国内仓","category":"仓储","desc":"发货国集货/贴标/拼箱。","tags":["国内"]},
    {"id":"w_bonded","label":"保税仓","category":"仓储","desc":"海关监管区内仓储，出区才征税。","tags":["保税"]},
    {"id":"w_oversea","label":"海外仓","category":"仓储","desc":"目的国本土备货，本地2-5天达。","tags":["核心"]},
    {"id":"w_fba","label":"FBA仓","category":"仓储","desc":"亚马逊运营中心，入仓后由平台发货+售后。","tags":["亚马逊"]},
    {"id":"w_frontend","label":"前置仓","category":"仓储","desc":"离消费者更近的极速达仓。","tags":["极速"]},
    {"id":"w_turnover","label":"库存周转","category":"仓储","desc":"货从进仓到卖出的平均天数，越短资金效率越高。","tags":["KPI"]},
    {"id":"w_safety","label":"安全库存","category":"仓储","desc":"应对不确定性的缓冲库存。","tags":["KPI"]},

    {"id":"pay_tt","label":"T/T 电汇","category":"支付","desc":"最常用，先款后货或定金+尾款。","tags":["常用"]},
    {"id":"pay_lc","label":"L/C 信用证","category":"支付","desc":"银行担保付款，单证一致才付。","tags":["银行"]},
    {"id":"pay_dp","label":"D/P 付款交单","category":"支付","desc":"买方付款后银行才放单。","tags":["托收"]},
    {"id":"pay_da","label":"D/A 承兑交单","category":"支付","desc":"买方承兑后即可拿单，到期付款。","tags":["托收"]},
    {"id":"pay_oa","label":"OA 赊销","category":"支付","desc":"先货后款，买方友好，卖方风险大。","tags":["信用"]},
    {"id":"pay_plat","label":"平台收款","category":"支付","desc":"PayPal/万里汇/连连等，跨境电商主流。","tags":["电商"]},
    {"id":"pay_fx","label":"汇率风险","category":"支付","desc":"跨币种结算产生的汇兑损益。","tags":["风险"]},
    {"id":"pay_lock","label":"锁汇","category":"支付","desc":"远期结售汇锁定汇率，对冲风险。","tags":["对冲"]},

    {"id":"r_damage","label":"货损","category":"风险","desc":"运输途中破损、丢失，买保险转移。","tags":["保险"]},
    {"id":"r_delay","label":"延误","category":"风险","desc":"港口拥堵/查验/天气等导致时效超标。","tags":["时效"]},
    {"id":"r_compliance","label":"合规风险","category":"风险","desc":"单证/认证/制裁违规，可能违法。","tags":["法律"]},
    {"id":"r_sanction","label":"制裁风险","category":"风险","desc":"触碰OFAC等制裁清单的合规风险。","tags":["法律"]},
    {"id":"r_credit","label":"信用风险","category":"风险","desc":"买方不付款或延期付款。","tags":["支付"]},
    {"id":"r_disrupt","label":"供应链中断","category":"风险","desc":"地缘冲突、疫情、单一供应商断供。","tags":["韧性"]},
    {"id":"r_icc_a","label":"ICC(A)条款","category":"风险","desc":"承保范围最广，几乎含一切风险。","tags":["保险"]},
    {"id":"r_icc_b","label":"ICC(B)条款","category":"风险","desc":"中等承保范围。","tags":["保险"]},
    {"id":"r_icc_c","label":"ICC(C)条款","category":"风险","desc":"承保范围最窄，仅重大灾害。","tags":["保险"]},

