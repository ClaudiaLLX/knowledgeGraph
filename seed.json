    {"id":"k_loss","label":"货损率","category":"指标","desc":"破损丢件比例。","tags":["KPI"]},

    {"id":"tr_ec","label":"跨境电商","category":"趋势","desc":"小包直发+海外仓双轨，倒逼物流碎片化柔性化。","tags":["趋势"]},
    {"id":"tr_rcep","label":"RCEP","category":"趋势","desc":"亚太区域自贸协定，原产累积规则利好区域供应链。","tags":["趋势"]},
    {"id":"tr_nearshoring","label":"近岸外包","category":"趋势","desc":"把产能移到靠近消费市场的国家以降风险。","tags":["趋势"]},
