    {"id":"s_blockchain","label":"区块链提单","category":"系统","desc":"电子提单，防篡改可转让。","tags":["前沿"]},

    {"id":"k_ftime","label":"履约时效","category":"指标","desc":"下单到签收的时长。","tags":["KPI"]},
    {"id":"k_ontime","label":"准时率","category":"指标","desc":"按承诺时间到达的比率。","tags":["KPI"]},
